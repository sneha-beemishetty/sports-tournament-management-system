<%- include('partials/header',{title:'Tournaments'}) %><h1 class="h2">Tournaments</h1><form class="d-flex gap-2 my-3"><input class="form-control" name="q" value="<%= (typeof query==='undefined'?'':query) %>" placeholder="Search tournaments"><button class="btn btn-outline-primary">Search</button></form><% if(admin){ %><div class="card mb-4"><div class="card-body"><h2 class="h5">Create tournament</h2><form method="post" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-4"><input class="form-control" name="name" placeholder="Tournament name" required></div><div class="col-md-2"><select class="form-select" name="sport_id"><% sports.forEach(s=>{ %><option value="<%= s.sport_id %>"><%= s.name %></option><% }) %></select></div><div class="col-md-2"><select name="format" class="form-select"><option>League</option><option>Knockout</option></select></div><div class="col-md-2"><input type="date" name="start_date" class="form-control" required></div><div class="col-md-2"><input type="date" name="end_date" class="form-control" required></div><div class="col-md-4"><input name="venue" class="form-control" placeholder="Venue" required></div><div class="col-md-2"><input name="team_limit" type="number" min="2" max="64" class="form-control" placeholder="Team limit" required></div><div class="col-md-2"><select name="status" class="form-select"><option>Registration</option><option>Upcoming</option><option>Ongoing</option></select></div><div class="col-md-2"><button class="btn btn-primary">Create</button></div></form></div></div><% } %><div class="row g-3"><% rows.forEach(t=>{ %><div class="col-lg-6"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5"><%= t.name %></h2><span class="badge text-bg-success"><%= t.status %></span></div><p class="mb-1"><%= t.sport_name %> · <%= t.format %></p><p class="text-secondary"><%= t.start_date %> – <%= t.end_date %> · <%= t.venue %></p><span><%= t.team_count %>/<%= t.team_limit %> teams</span><% if(t.format==='Knockout'){ %><a href="/knockout/<%= t.tournament_id %>" class="btn btn-sm btn-outline-primary ms-2">Bracket</a><% } %><% if(admin){ %><form method="post" action="/tournaments/<%= t.tournament_id %>/delete" class="d-inline float-end"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this tournament?')">Delete</button></form><% } %></div></div></div><% }) %></div><% if(!rows.length){ %><p>No tournaments match that search.</p><% } %><%- include('partials/footer') %>
