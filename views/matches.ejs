<%- include('partials/header',{title:'Fixtures and results'}) %><h1 class="h2">Fixtures and results</h1><form class="row g-2 my-3"><div class="col-md-5"><select name="tournament" class="form-select"><option value="0">All tournaments</option><% tournaments.forEach(t=>{ %><option value="<%= t.tournament_id %>"><%= t.name %></option><% }) %></select></div><div class="col-md-4"><select name="status" class="form-select"><option value="">Any status</option><option>Scheduled</option><option>Completed</option><option>Postponed</option></select></div><div class="col-md-2"><button class="btn btn-outline-primary">Filter</button></div></form><% if(admin){ %><div class="card mb-4"><div class="card-body"><h2 class="h5">Schedule match</h2><form method="post" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-3"><select name="tournament_id" class="form-select"><% tournaments.forEach(t=>{ %><option value="<%= t.tournament_id %>"><%= t.name %></option><% }) %></select></div><div class="col-md-2"><input name="match_number" type="number" min="1" class="form-control" placeholder="Match #" required></div><div class="col-md-2"><input name="round_name" class="form-control" placeholder="Round" required></div><div class="col-md-3"><input name="home_registration_id" type="number" class="form-control" placeholder="Home registration ID" required></div><div class="col-md-3"><input name="away_registration_id" type="number" class="form-control" placeholder="Away registration ID" required></div><div class="col-md-2"><input name="match_date" type="date" class="form-control" required></div><div class="col-md-2"><input name="match_time" type="time" class="form-control" required></div><div class="col-md-3"><input name="venue" class="form-control" placeholder="Venue" required></div><div class="col-md-2"><button class="btn btn-primary">Schedule</button></div></form><small class="text-secondary">Enter registration IDs from the registrations table below Teams.</small></div></div><% } %><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Tournament/round</th><th>Fixture</th><th>Score</th><th>Status</th><% if(admin){ %><th>Update</th><% } %></tr></thead><tbody><% matches.forEach(m=>{ %><tr><td><%= m.match_date %><br><%= m.match_time %></td><td><%= m.tournament_name %><br><small><%= m.round_name %></small></td><td><%= m.home_team %> vs <%= m.away_team %></td><td><%= m.home_score==null?'—':m.home_score+' – '+m.away_score %><% if(m.winner){ %><br><small>Winner: <%= m.winner %></small><% } %></td><td><%= m.status %></td><% if(admin){ %><td><form method="post" action="/matches/<%= m.match_id %>/result" class="d-flex gap-1"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="home_score" type="number" min="0" class="form-control form-control-sm" placeholder="Home"><input name="away_score" type="number" min="0" class="form-control form-control-sm" placeholder="Away"><select name="status" class="form-select form-select-sm"><option>Completed</option><option>Scheduled</option><option>Postponed</option></select><button class="btn btn-sm btn-primary">Save</button></form></td><% } %></tr><% }) %></tbody></table></div><% if(!matches.length){ %><p>No matches found.</p><% } %><%- include('partials/footer') %>
