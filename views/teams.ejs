<%- include('partials/header',{title:'Teams'}) %><h1 class="h2">Teams</h1><form class="d-flex gap-2 my-3"><input name="q" class="form-control" placeholder="Search teams"><button class="btn btn-outline-primary">Search</button></form><% if(admin){ %><div class="card mb-4"><div class="card-body"><h2 class="h5">Add a team</h2><form method="post" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-3"><input name="name" class="form-control" placeholder="Team name" required></div><div class="col-md-3"><input name="coach_name" class="form-control" placeholder="Coach" required></div><div class="col-md-3"><input name="contact_email" type="email" class="form-control" placeholder="Email" required></div><div class="col-md-2"><input name="contact_phone" class="form-control" placeholder="Phone"></div><div class="col-md-1"><button class="btn btn-primary">Add</button></div></form></div></div><div class="card mb-4"><div class="card-body"><h2 class="h5">Register team for tournament</h2><form method="post" action="/teams/register" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><select class="form-select" name="tournament_id" required><% tournaments.forEach(t=>{ %><option value="<%= t.tournament_id %>"><%= t.name %> (<%= t.team_count %>/<%= t.team_limit %>)</option><% }) %></select><select class="form-select" name="team_id" required><% teams.forEach(t=>{ %><option value="<%= t.team_id %>"><%= t.name %></option><% }) %></select><button class="btn btn-primary text-nowrap">Register</button></form></div></div><% } %><div class="row g-3"><% teams.forEach(t=>{ %><div class="col-md-6 col-lg-4"><div class="card"><div class="card-body"><h2 class="h5"><%= t.name %></h2><p class="mb-1">Coach: <%= t.coach_name %></p><p class="mb-0 text-secondary"><%= t.contact_email %></p></div></div></div><% }) %></div><h2 class="h4 mt-4">Tournament registrations</h2><div class="table-responsive"><table class="table"><thead><tr><th>Tournament</th><th>Team</th><th>Registered</th></tr></thead><tbody><% registrations.forEach(r=>{ %><tr><td><%= r.tournament_name %></td><td><%= r.team_name %></td><td><%= r.registered_at %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
