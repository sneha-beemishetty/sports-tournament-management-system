<div class="table-responsive"><table class="table table-hover"><thead><tr><th>Date</th><th>Tournament</th><th>Match</th><th>Round</th><th>Venue</th></tr></thead><tbody><% matches.forEach(m=>{ %><tr><td><%= m.match_date %> <%= m.match_time %></td><td><%= m.tournament_name %></td><td><%= m.home_team %> vs <%= m.away_team %></td><td><%= m.round_name %></td><td><%= m.venue %></td></tr><% }) %></tbody></table></div><% if(!matches.length){ %><p class="text-secondary">No fixtures to display.</p><% } %>
