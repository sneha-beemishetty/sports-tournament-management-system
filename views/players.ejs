<%- include('partials/header',{title:'Players'}) %><h1 class="h2">Players</h1><form class="d-flex gap-2 my-3"><input name="q" class="form-control" placeholder="Search players"><button class="btn btn-outline-primary">Search</button></form><% if(admin){ %><div class="card mb-4"><div class="card-body"><h2 class="h5">Add player</h2><form method="post" class="row g-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="col-md-3"><input name="full_name" class="form-control" placeholder="Full name" required></div><div class="col-md-3"><select name="team_id" class="form-select"><% teams.forEach(t=>{ %><option value="<%= t.team_id %>"><%= t.name %></option><% }) %></select></div><div class="col-md-2"><input name="date_of_birth" type="date" class="form-control" required></div><div class="col-md-2"><input name="playing_position" class="form-control" placeholder="Position"></div><div class="col-md-1"><input name="jersey_number" type="number" min="1" max="99" class="form-control" placeholder="#" required></div><div class="col-md-1"><button class="btn btn-primary">Add</button></div></form></div></div><% } %><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Player</th><th>Team</th><th>Born</th><th>Position</th><th>Jersey</th></tr></thead><tbody><% players.forEach(p=>{ %><tr><td><%= p.full_name %></td><td><%= p.team_name %></td><td><%= p.date_of_birth %></td><td><%= p.playing_position||'—' %></td><td><%= p.jersey_number %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
