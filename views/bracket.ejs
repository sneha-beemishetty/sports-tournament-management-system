<%- include('partials/header',{title:'Knockout bracket'}) %><h1 class="h2">Knockout bracket</h1><div class="row g-3"><% rows.forEach(m=>{ %><div class="col-md-6 col-xl-4"><div class="card"><div class="card-header"><%= m.round_name %> · Match <%= m.match_number %></div><div class="card-body"><p><%= m.home_team %> <b><%= m.home_score==null?'':m.home_score %></b></p><p><%= m.away_team %> <b><%= m.away_score==null?'':m.away_score %></b></p><p class="mb-0"><% if(m.winner){ %>Winner: <%= m.winner %><% } else { %><%= m.status %><% } %></p></div></div></div><% }) %></div><% if(!rows.length){ %><p>No knockout matches are scheduled.</p><% } %><%- include('partials/footer') %>
