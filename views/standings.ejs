<%- include('partials/header',{title:'League standings'}) %><h1 class="h2">League standings</h1><form class="mb-3"><select name="tournament" class="form-select w-auto d-inline"><% tournaments.forEach(t=>{ %><option value="<%= t.tournament_id %>" <%= selected===t.tournament_id?'selected':'' %>><%= t.name %></option><% }) %></select> <button class="btn btn-outline-primary">Show</button></form><p class="text-secondary">Order: points, goal/score difference, then score for; final tie uses team name. Points are tournament-configured.</p><div class="table-responsive"><table class="table table-striped"><thead><tr><th>#</th><th>Team</th><th>P</th><th>W</th><th>D</th><th>L</th><th>For</th><th>Against</th><th>Diff</th><th>Pts</th></tr></thead><tbody><% rows.forEach((r,i)=>{ %><tr><td><%= i+1 %></td><td><%= r.team_name %></td><td><%= r.played %></td><td><%= r.wins %></td><td><%= r.draws %></td><td><%= r.losses %></td><td><%= r.scored %></td><td><%= r.conceded %></td><td><%= r.goal_difference %></td><td class="fw-bold"><%= r.points %></td></tr><% }) %></tbody></table></div><% if(!rows.length){ %><p>No league registrations yet.</p><% } %><%- include('partials/footer') %>
