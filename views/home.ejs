<%- include('partials/header',{title:'Home'}) %><section class="hero p-5 rounded-4 mb-4 text-white"><div class="col-lg-8"><span class="badge text-bg-warning mb-3">Fixtures · Results · Standings</span><h1 class="display-5 fw-bold">Sports Tournament<br>and Match Management System</h1><p class="lead">A single place to follow campus tournaments, teams, fixtures and scores.</p><a class="btn btn-light btn-lg" href="/tournaments">Explore tournaments</a></div></section><div class="row g-4"><div class="col-lg-7"><h2 class="h4">Available tournaments</h2><% tournaments.forEach(t=>{ %><div class="card mb-2"><div class="card-body d-flex justify-content-between"><div><strong><%= t.name %></strong><div class="text-secondary"><%= t.sport_name %> · <%= t.format %> · <%= t.start_date %></div></div><span class="badge text-bg-success align-self-start"><%= t.status %></span></div></div><% }) %><% if(!tournaments.length){ %><p>No tournaments available yet.</p><% } %></div><div class="col-lg-5"><h2 class="h4">Upcoming matches</h2><% matches.forEach(m=>{ %><div class="card mb-2"><div class="card-body"><small class="text-secondary"><%= m.tournament_name %> · <%= m.match_date %> <%= m.match_time %></small><div class="fw-semibold"><%= m.home_team %> <span class="text-secondary">vs</span> <%= m.away_team %></div><small><%= m.venue %></small></div></div><% }) %><% if(!matches.length){ %><p>No upcoming fixtures.</p><% } %></div></div><h2 class="h4 mt-5">Recent results</h2><div class="table-responsive"><table class="table"><thead><tr><th>Tournament</th><th>Fixture</th><th>Score</th><th>Date</th></tr></thead><tbody><% results.forEach(r=>{ %><tr><td><%= r.tournament_name %></td><td><%= r.home_team %> vs <%= r.away_team %></td><td><%= r.home_score %>–<%= r.away_score %></td><td><%= r.match_date %></td></tr><% }) %></tbody></table></div><%- include('partials/footer') %>
