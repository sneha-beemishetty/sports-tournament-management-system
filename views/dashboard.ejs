<%- include('partials/header',{title:'Admin Dashboard'}) %><h1 class="h2 mb-4">Admin dashboard</h1><div class="row g-3 mb-4"><% [['Tournaments',stats.tournaments],['Teams',stats.teams],['Players',stats.players],['Matches',stats.matches]].forEach(x=>{ %><div class="col-6 col-lg-3"><div class="stat-card"><small><%= x[0] %></small><div class="display-6 fw-bold"><%= x[1] %></div></div></div><% }) %></div><div class="d-flex gap-2 flex-wrap mb-4"><a class="btn btn-primary" href="/tournaments">Manage tournaments</a><a class="btn btn-primary" href="/teams">Manage teams</a><a class="btn btn-primary" href="/players">Manage players</a><a class="btn btn-primary" href="/matches">Fixtures & results</a></div><h2 class="h4">Upcoming fixtures</h2><%- include('partials/fixtures',{matches:upcoming}) %><h2 class="h4 mt-4">Recent results</h2><div class="table-responsive"><table class="table"><% recent.forEach(r=>{ %><tr><td><%= r.match_date %></td><td><%= r.tournament_name %></td><td><%= r.home_team %> <b><%= r.home_score %>–<%= r.away_score %></b> <%= r.away_team %></td></tr><% }) %></table></div><%- include('partials/footer') %>
